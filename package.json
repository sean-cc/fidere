{
  "name": "fidere",
  "version": "1.0.0",
  "description": "A small agent workspace in the browser, built on the pi SDK.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "fidere": "scripts/start.mjs"
  },
  "files": [
    "DEVELOPMENT.md",
    "daemon.js",
    "default-models.js",
    "docs/*.md",
    "docs/screenshot-chat.jpg",
    "docs/screenshot-models.jpg",
    "guard-core.js",
    "guard.ts",
    "prices.js",
    "public/",
    "runner.js",
    "scripts/setup.mjs",
    "scripts/start.mjs",
    "server.js",
    "workflows/"
  ],
  "keywords": [
    "agent",
    "agent-workspace",
    "ai-agent",
    "claude",
    "deepseek",
    "developer-tools",
    "llm",
    "nodejs",
    "openai",
    "pi-agent",
    "pi-coding-agent",
    "self-hosted",
    "web-ui",
    "zero-dependencies"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sean-cc/fidere.git"
  },
  "homepage": "https://github.com/sean-cc/fidere#readme",
  "bugs": {
    "url": "https://github.com/sean-cc/fidere/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs --watch",
    "smoke": "node scripts/smoke.mjs",
    "test:prices": "node --test scripts/prices-test.mjs",
    "test:markdown": "node --test scripts/markdown-test.mjs",
    "test:defaults": "node --test scripts/default-models-test.mjs",
    "start:awake": "caffeinate -ims node scripts/start.mjs",
    "setup": "node scripts/setup.mjs",
    "test:sdk": "node --test scripts/start-test.mjs",
    "test": "npm run test:prices && npm run test:markdown && npm run test:defaults && npm run test:sdk && npm run test:daemon && npm run test:guard",
    "daemon": "node daemon.js",
    "test:daemon": "node --test scripts/daemon-test.mjs",
    "test:guard": "node --test scripts/guard-test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2"
  }
}
